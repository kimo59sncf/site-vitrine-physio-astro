---
import { Award, Users, Heart, Target } from 'lucide-react';
import OptimizedImage from './OptimizedImage.astro';
---

<section id="about" class="py-20 md:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- En-tête de section -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-medical-blue mb-4">
        À Propos de PhysioKbNyon
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Découvrez notre cabinet de physiothérapie et notre approche personnalisée pour votre santé et votre bien-être.
      </p>
    </div>

    <!-- Grille principale -->
    <div class="grid lg:grid-cols-2 gap-16 items-center mb-20">
      <!-- Texte de présentation -->
      <div class="space-y-6">
        <h3 class="text-3xl font-bold text-medical-blue mb-4">
          Votre Santé, Notre Priorité
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Depuis plus de 15 ans, PhysioKbNyon s'engage à offrir des soins de physiothérapie de qualité supérieure à Nyon et ses environs. Notre cabinet est spécialisé dans la rééducation, la thérapie manuelle et l'optimisation de la performance sportive.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Nous croyons en une approche holistique, combinant les dernières techniques médicales avec une écoute attentive de vos besoins individuels. Chaque patient reçoit un plan de traitement personnalisé pour atteindre ses objectifs de santé.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Notre équipe qualifiée est formée aux méthodes les plus récentes et utilise un équipement moderne pour garantir des résultats optimaux dans un environnement confortable et professionnel.
        </p>
      </div>

      <!-- Carrousel Équipe & Diplômes -->
      <div class="relative rounded-2xl overflow-hidden shadow-xl">
        <div class="relative h-[500px] overflow-hidden">
          <!-- Images du carrousel -->
          <div id="carousel-slides" class="flex transition-transform duration-700 ease-in-out h-full">
            <!-- Slide 1 : Équipe -->
            <div class="min-w-full h-full relative">
              <img src="/images/equipe.webp" alt="Équipe Qualifiée PhysioKbNyon" class="w-full h-full object-cover rounded-xl">
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h4 class="text-2xl font-bold mb-2">Équipe Qualifiée</h4>
                <p class="text-blue-100">Plus de 15 ans d'expérience au service de votre santé</p>
              </div>
            </div>
            <!-- Slide 2 : Diplôme Marie Hélène -->
            <div class="min-w-full h-full relative bg-gray-50">
              <img src="/images/diplomeMarie.jpeg" alt="Diplôme officiel Marie Hélène" class="w-full h-full object-contain p-8">
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-white/90 to-transparent">
                <h4 class="text-2xl font-bold text-medical-blue mb-2">Marie Hélène</h4>
                <p class="text-gray-600">Diplôme d'État de Kinésithérapie - Formation certifiée</p>
              </div>
            </div>
            <!-- Slide 3 : Diplôme Rayan -->
            <div class="min-w-full h-full relative bg-gray-50">
              <img src="/images/diplomeRayen.jpeg" alt="Diplôme officiel Rayan" class="w-full h-full object-contain p-8">
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-white/90 to-transparent">
                <h4 class="text-2xl font-bold text-medical-blue mb-2">Rayan</h4>
                <p class="text-gray-600">Diplôme d'État de Kinésithérapie - Expert en rééducation fonctionnelle</p>
              </div>
            </div>
          </div>
          
          <!-- Contrôles navigation -->
          <button id="carousel-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/90 rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-colors z-10">
            <svg class="w-6 h-6 text-medical-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button id="carousel-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/90 rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-colors z-10">
            <svg class="w-6 h-6 text-medical-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
          
          <!-- Indicateurs -->
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-10">
            <button class="carousel-dot w-3 h-3 rounded-full bg-white shadow-md" data-index="0"></button>
            <button class="carousel-dot w-3 h-3 rounded-full bg-white/50 shadow-md" data-index="1"></button>
            <button class="carousel-dot w-3 h-3 rounded-full bg-white/50 shadow-md" data-index="2"></button>
          </div>
        </div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const slides = document.getElementById('carousel-slides');
          const prevBtn = document.getElementById('carousel-prev');
          const nextBtn = document.getElementById('carousel-next');
          const dots = document.querySelectorAll('.carousel-dot');
          let currentSlide = 0;
          const totalSlides = 3;
          
          function updateCarousel() {
            slides.style.transform = `translateX(-${currentSlide * 100}%)`;
            dots.forEach((dot, index) => {
              dot.classList.toggle('bg-white', index === currentSlide);
              dot.classList.toggle('bg-white/50', index !== currentSlide);
            });
          }
          
          nextBtn.addEventListener('click', () => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
          });
          
          prevBtn.addEventListener('click', () => {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateCarousel();
          });
          
          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              currentSlide = index;
              updateCarousel();
            });
          });
          
          // Auto slide toutes les 5 secondes
          setInterval(() => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
          }, 5000);
        });
      </script>
    </div>

    <!-- Valeurs -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-medical-blue rounded-lg flex items-center justify-center mx-auto mb-4">
          <Heart size={32} class="text-white" />
        </div>
        <h4 class="text-xl font-bold text-medical-blue mb-2">Empathie</h4>
        <p class="text-gray-600 text-sm">
          Nous écoutons vos préoccupations et adaptons nos soins à vos besoins émotionnels et physiques.
        </p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-medical-blue rounded-lg flex items-center justify-center mx-auto mb-4">
          <Target size={32} class="text-white" />
        </div>
        <h4 class="text-xl font-bold text-medical-blue mb-2">Précision</h4>
        <p class="text-gray-600 text-sm">
          Des diagnostics précis et des traitements ciblés pour des résultats durables.
        </p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-medical-blue rounded-lg flex items-center justify-center mx-auto mb-4">
          <Award size={32} class="text-white" />
        </div>
        <h4 class="text-xl font-bold text-medical-blue mb-2">Excellence</h4>
        <p class="text-gray-600 text-sm">
          Formation continue et utilisation des techniques les plus avancées en physiothérapie.
        </p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-medical-blue rounded-lg flex items-center justify-center mx-auto mb-4">
          <Users size={32} class="text-white" />
        </div>
        <h4 class="text-xl font-bold text-medical-blue mb-2">Accompagnement</h4>
        <p class="text-gray-600 text-sm">
          Un suivi personnalisé tout au long de votre parcours de rééducation.
        </p>
      </div>
    </div>

    <!-- Section Diplômes et Certifications -->
    <div class="mt-24">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-medical-blue rounded-full mb-4">
          <Award size={32} class="text-white" />
        </div>
        <h3 class="text-3xl font-bold text-medical-blue mb-3">Nos Diplômes & Certifications</h3>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Notre équipe possède des formations reconnues et certifiées pour vous garantir des soins de qualité.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Diplôme Marie Hélène -->
        <div class="group">
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-2 border border-gray-100">
            <div class="relative aspect-[4/3] bg-gray-50">
              <OptimizedImage 
                src="/images/diplomeMarie.jpeg" 
                alt="Diplôme officiel de Marie Hélène, kinésithérapeute certifiée"
                className="w-full h-full object-contain p-4 group-hover:scale-[1.02] transition-transform duration-500"
                width={800}
                height={600}
              />
            </div>
            <div class="p-6 text-center">
              <h4 class="text-xl font-bold text-medical-blue mb-2">Marie Hélène</h4>
              <p class="text-gray-600">Diplôme d'État de Kinésithérapie</p>
            </div>
          </div>
        </div>

        <!-- Diplôme Rayan -->
        <div class="group">
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-2 border border-gray-100">
            <div class="relative aspect-[4/3] bg-gray-50">
              <OptimizedImage 
                src="/images/diplomeRayen.jpeg" 
                alt="Diplôme officiel de Rayan, kinésithérapeute certifié"
                className="w-full h-full object-contain p-4 group-hover:scale-[1.02] transition-transform duration-500"
                width={800}
                height={600}
              />
            </div>
            <div class="p-6 text-center">
              <h4 class="text-xl font-bold text-medical-blue mb-2">Rayan</h4>
              <p class="text-gray-600">Diplôme d'État de Kinésithérapie</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Appel à l'action -->
    <div class="text-center mt-16">
      <a
        href="#booking"
        class="inline-block bg-medical-blue text-white px-8 py-3 rounded-lg font-bold hover:bg-medical-blue-dark transition-colors shadow-lg"
      >
        Commencer Votre Rééducation
      </a>
    </div>
  </div>
</section>