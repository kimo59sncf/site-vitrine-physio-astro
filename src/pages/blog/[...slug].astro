---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';

const SITE_URL = 'https://www.physiokbnyon.ch';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, publishDate, updatedDate, author, image, tags, keywords } = post.data;

const canonicalUrl = `${SITE_URL}/blog/${post.slug}`;
const fullTitle = `${title} | Blog PhysioKbNyon`;
const defaultKeywords = 'physiothérapie Nyon, kinésithérapeute Suisse, rééducation, santé, bien-être';

const formattedPublishDate = publishDate.toLocaleDateString('fr-CH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate
  ? updatedDate.toLocaleDateString('fr-CH', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonicalUrl,
  headline: title,
  description: description,
  url: canonicalUrl,
  datePublished: publishDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : publishDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'PhysioKbNyon',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/logoPhysio.webp`,
    },
  },
  image: `${SITE_URL}${image}`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  keywords: keywords || tags.join(', '),
  isAccessibleForFree: true,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${SITE_URL}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Quels sont les services proposés par PhysioKbNyon ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'PhysioKbNyon propose de la physiothérapie générale et spécialisée, de la chiropractie, de la massothérapie, des services à domicile, et des programmes personnalisés de rééducation à Nyon.',
      },
    },
    {
      '@type': 'Question',
      name: 'Comment prendre rendez-vous chez PhysioKbNyon ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Vous pouvez prendre rendez-vous par téléphone au 02 77 44 44 88, via notre formulaire en ligne sur physiokbnyon.ch, ou en vous rendant directement à notre cabinet situé au 8 Rue Morache, 1260 Nyon.',
      },
    },
    {
      '@type': 'Question',
      name: 'La physiothérapie est-elle remboursée par l\'assurance en Suisse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oui, la physiothérapie est remboursée par l\'assurance de base (LAMal) en Suisse, sur prescription médicale. Depuis 2023, l\'accès direct au physiothérapeute est également possible sous certaines conditions.',
      },
    },
  ],
};
---

<Layout>
  <SEO
    title={fullTitle}
    description={description}
    canonicalUrl={canonicalUrl}
    keywords={keywords || defaultKeywords}
    image={image}
    isHomePage={false}
  />

  <article
    class="py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-blue-50/30"
    itemScope
    itemType="https://schema.org/BlogPosting"
  >
    <div class="max-w-3xl mx-auto">
      <!-- Fil d'ariane -->
      <nav aria-label="Fil d'ariane" class="mb-8 text-sm text-gray-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-[#2B6FF3] transition-colors">Accueil</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog" class="hover:text-[#2B6FF3] transition-colors">Blog</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-gray-900 font-medium truncate max-w-[200px]">{title}</li>
        </ol>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <span class="text-xs font-medium bg-[#2B6FF3]/10 text-[#2B6FF3] px-3 py-1.5 rounded-full">
            {tag}
          </span>
        ))}
      </div>

      <!-- Titre -->
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight"
        itemProp="headline"
      >
        {title}
      </h1>

      <!-- Métadonnées -->
      <div class="flex flex-wrap items-center gap-4 text-gray-500 text-sm mb-8">
        <span itemProp="author" class="font-medium text-gray-700">
          {author}
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={publishDate.toISOString()} itemProp="datePublished">
          {formattedPublishDate}
        </time>
        {formattedUpdatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="italic">
              Mis à jour le{' '}
              <time datetime={updatedDate!.toISOString()} itemProp="dateModified">
                {formattedUpdatedDate}
              </time>
            </span>
          </>
        )}
      </div>

      <!-- Image -->
      <img
        src={image}
        alt={title}
        class="w-full h-64 sm:h-96 object-cover rounded-2xl mb-10 shadow-lg"
        itemProp="image"
        width="1200"
        height="630"
      />

      <!-- Contenu de l'article -->
      <div
        class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-[#2B6FF3] prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-blockquote:border-l-[#2B6FF3] prose-blockquote:bg-blue-50/50 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-table:border-collapse prose-th:bg-gray-50 prose-th:px-4 prose-th:py-2 prose-td:px-4 prose-td:py-2 prose-li:text-gray-700"
        itemProp="articleBody"
      >
        <Content />
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-gradient-to-r from-[#2B6FF3] to-[#1E5BD8] rounded-2xl p-8 text-white text-center shadow-lg">
        <h2 class="text-2xl font-bold mb-3">Besoin d'un physiothérapeute à Nyon ?</h2>
        <p class="text-blue-100 mb-6 max-w-lg mx-auto">
          Notre équipe de professionnels est à votre disposition pour vous accompagner dans votre
          rétablissement. Prenez rendez-vous dès aujourd'hui.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="tel:+41277444488"
            class="inline-flex items-center gap-2 bg-white text-[#2B6FF3] font-semibold px-6 py-3 rounded-full hover:bg-blue-50 transition-colors shadow-md"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            02 77 44 44 88
          </a>
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 border-2 border-white text-white font-semibold px-6 py-3 rounded-full hover:bg-white hover:text-[#2B6FF3] transition-colors"
          >
            Prendre rendez-vous
          </a>
        </div>
      </div>

      <!-- Navigation entre articles -->
      <nav class="mt-12 pt-8 border-t border-gray-200" aria-label="Navigation entre articles">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-[#2B6FF3] font-semibold hover:underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Retour au blog
        </a>
      </nav>
    </div>
  </article>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />