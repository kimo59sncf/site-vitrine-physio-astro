---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

const SITE_URL = 'https://www.physiokbnyon.ch';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const pageTitle = 'Blog - Conseils & actualités en physiothérapie';
const pageDescription = 'Retrouvez nos articles, conseils d\'experts et actualités sur la physiothérapie, la chiropractie et la rééducation à Nyon. Tous nos contenus sont rédigés par des professionnels de santé.';
const canonicalUrl = `${SITE_URL}/blog`;

// Schema JSON-LD pour la page blog
const blogListingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog PhysioKbNyon',
  url: canonicalUrl,
  description: pageDescription,
  author: {
    '@type': 'Organization',
    name: 'PhysioKbNyon',
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${SITE_URL}/blog/${post.slug}`,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: post.data.updatedDate
      ? post.data.updatedDate.toISOString()
      : post.data.publishDate.toISOString(),
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    image: `${SITE_URL}${post.data.image}`,
  })),
};
---

<Layout>
  <SEO
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={canonicalUrl}
    keywords="blog physiothérapie Nyon, conseils kiné, articles rééducation, chiropractie, santé dos, exercices physiothérapie"
    isHomePage={false}
  />

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-blue-50/30">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <span class="text-[#2B6FF3] font-semibold tracking-wider uppercase text-sm">Blog</span>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mt-4 mb-6">
        Conseils & actualités en physiothérapie
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Des articles rédigés par notre équipe de physiothérapeutes et chiropracteurs à Nyon pour
        vous aider à mieux comprendre votre corps et optimiser votre santé.
      </p>
    </div>

    {
      posts.length === 0 && (
        <div class="text-center py-16">
          <p class="text-gray-500 text-lg">Aucun article pour le moment. Revenez bientôt !</p>
        </div>
      )
    }

    <div class="max-w-7xl mx-auto grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => {
          const formattedDate = post.data.publishDate.toLocaleDateString('fr-CH', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article
              class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group flex flex-col"
              itemScope
              itemType="https://schema.org/BlogPosting"
            >
              <a
                href={`/blog/${post.slug}`}
                class="block overflow-hidden"
                aria-label={`Lire l'article : ${post.data.title}`}
              >
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="600"
                  height="400"
                  itemProp="image"
                />
              </a>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs font-medium bg-[#2B6FF3]/10 text-[#2B6FF3] px-2.5 py-1 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={`/blog/${post.slug}`} class="group/link flex-1">
                  <h2
                    class="text-lg font-bold text-gray-900 mb-2 group-hover/link:text-[#2B6FF3] transition-colors"
                    itemProp="headline"
                  >
                    {post.data.title}
                  </h2>
                </a>
                <p class="text-gray-600 text-sm line-clamp-3 mb-4" itemProp="description">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                  <span class="text-xs text-gray-500" itemProp="author">
                    {post.data.author}
                  </span>
                  <time
                    datetime={post.data.publishDate.toISOString()}
                    class="text-xs text-gray-400"
                    itemProp="datePublished"
                  >
                    {formattedDate}
                  </time>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(blogListingSchema)} />