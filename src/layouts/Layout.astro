---
import { ViewTransitions } from 'astro:transitions';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import WhatsAppButton from '../components/WhatsAppButton';
import GTMHead from '../components/GTMHead.astro';
import GTMBody from '../components/GTMBody.astro';
import GTagHead from '../components/GTagHead.astro';
import ConsentBanner from '../components/ConsentBanner';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;

// Configuration GTM - Remplacer par votre ID GTM
const GTM_ID = import.meta.env.GTM_ID || 'GTM-WNRKJDN7';

// Configuration Google Analytics 4 - ID de mesure
const GA4_MEASUREMENT_ID = import.meta.env.GA4_MEASUREMENT_ID || 'G-90D5SJC700';

export interface Props {
  seo: SEOProps;
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <!-- Google Tag Manager - Le plus haut possible dans le head -->
    <GTMHead gtmId={GTM_ID} />
    
    <!-- Google Analytics (gtag.js) - Direct measurement -->
    <GTagHead measurementId={GA4_MEASUREMENT_ID} />
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <ViewTransitions />

    <SEO {...seo} />
  </head>
  <body class="min-h-screen flex flex-col text-gray-800 bg-white">
    <!-- Google Tag Manager (noscript) -->
    <GTMBody gtmId={GTM_ID} />
    
    <slot />

    <WhatsAppButton
      client:load
      phoneNumber="41277444488"
      message="Bonjour, je souhaite prendre rendez-vous pour une séance de physiothérapie."
    />
    
    <!-- Bannière de consentement RGPD/LPD -->
    <ConsentBanner client:load />
  </body>
</html>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.animate-fadeIn) {
    animation: fadeIn 0.3s ease-in-out;
  }
</style>
