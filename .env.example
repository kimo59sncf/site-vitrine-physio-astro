# Configuration du site Physiothérapie

# Environnement (production ou development)
NODE_ENV=production

# Port d'écoute de l'application
PORT=4327
HOST=0.0.0.0

# Variables optionnelles pour le site
SITE_URL=https://physiokbnyon.ch
CONTACT_EMAIL=contact@physiokbnyon.ch

# Google Tag Manager (GTM)
GTM_ID=GTM-WNRKJDN7

# Google Analytics 4 (GA4) - ID de mesure
GA4_MEASUREMENT_ID=G-90D5SJC700

# OpenAI - Génération automatique d'articles de blog
# Obtenez votre clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=votre_cle_api_openai
# Modèle optionnel (défaut : gpt-4o)
# OPENAI_MODEL=gpt-4o

# ==================== Email (formulaire de contact) ====================
# SMTP Infomaniak - OBLIGATOIRE pour l'envoi d'emails
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=contact@physiokbnyon.ch
SMTP_PASS=mot_de_passe_email_a_definir

# ==================== Espace Admin (/admin) ====================
# Accès à l'historique des demandes de contact - OBLIGATOIRE
ADMIN_USER=admin
ADMIN_PASSWORD=mot_de_passe_admin_fort_a_definir

# ==================== Umami (analytics auto-hébergé) ====================
# ID du site dans Umami (récupéré après la 1ère connexion à /umami)
PUBLIC_UMAMI_WEBSITE_ID=
# Mot de passe de la base PostgreSQL Umami - OBLIGATOIRE
UMAMI_DB_PASSWORD=mot_de_passe_db_aleatoire
# Secret de session Umami (chaîne aléatoire, ex: openssl rand -hex 32) - OBLIGATOIRE
UMAMI_APP_SECRET=secret_aleatoire_64_caracteres

# ==================== Données ====================
# Dossier de persistance (demandes + ordonnances) - défaut: /app/data en Docker
# DATA_DIR=/app/data
